 namespace rex::filesystem {
 
+namespace {
+// GOWJ_VFS_OVERRIDES="guest/relative/path=C:\host\file;other=..." substitutes individual files of a
+// read-only game folder with files from elsewhere, without touching the game folder.
+std::string LowerSlashes(std::string s) {
+  for (char& c : s) {
+    if (c == '\\') c = '/';
+    c = char(std::tolower(static_cast<unsigned char>(c)));
+  }
+  return s;
+}
+const std::vector<std::pair<std::string, std::filesystem::path>>& FileOverrides() {
+  static const auto table = [] {
+    std::vector<std::pair<std::string, std::filesystem::path>> t;
+    const char* env = std::getenv("GOWJ_VFS_OVERRIDES");
+    if (!env || !*env) return t;
+    std::string all = env;
+    size_t pos = 0;
+    while (pos <= all.size()) {
+      size_t end = all.find(';', pos);
+      if (end == std::string::npos) end = all.size();
+      const std::string item = all.substr(pos, end - pos);
+      const size_t eq = item.find('=');
+      if (eq != std::string::npos && eq > 0) {
+        t.emplace_back(LowerSlashes(item.substr(0, eq)), std::filesystem::path(item.substr(eq + 1)));
+      }
+      pos = end + 1;
+    }
+    return t;
+  }();
+  return table;
+}
